{
  "name": "wolfmind-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:backend-smoke": "node e2e-smoke.mjs",
    "e2e:http-uuid": "node http-uuid-browser-check.mjs",
    "e2e:adapters": "vitest run --config vitest.integration.config.ts",
    "e2e:pages": "vitest run --config vitest.pages.config.ts",
    "e2e:ws": "vitest run --config vitest.ws.config.ts",
    "e2e:browsers": "playwright test"
  },
  "dependencies": {
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.0.0"
  }
}
