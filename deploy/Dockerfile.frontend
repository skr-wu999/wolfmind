# WolfMind 前端镜像（多阶段）：Node 构建静态产物 → Nginx 提供静态文件并反代 API/WS。
#
# 关键设计：`VITE_USE_REAL_API` 与 `VITE_API_BASE_URL` 是**构建期**变量（Vite 会把它们内联进产物）。
# 因此镜像必须在构建时拿到它们，而"运行期改环境变量"对这两个值无效——这一点写在
# docs/ops/deployment.md 里，避免有人以为改 compose 的 environment 就能切换后端地址。
#
# 部署形态是**同源**：前端由 Nginx 提供，`/api` 与 `/ws` 由同一台 Nginx 反代到后端。
# 因此 `VITE_API_BASE_URL` 留空，请求走当前站点（`config.ts` 的默认行为），
# 不需要 CORS，也不需要在前端硬编码后端主机名。

# ---------------------------------------------------------------- 构建阶段
FROM node:22-alpine AS build
WORKDIR /workspace/frontend

# 先装依赖再拷源码：源码改动不会让 npm ci 重跑。
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
# 同源部署：空 base URL 让请求走当前站点（Nginx 的 /api 与 /ws 反代）。
ARG VITE_API_BASE_URL=""
ARG VITE_WS_URL=""
ARG VITE_USE_REAL_API="true"
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_WS_URL=${VITE_WS_URL} \
    VITE_USE_REAL_API=${VITE_USE_REAL_API}
# 构建会跑 vue-tsc 类型检查（package.json 的 build 脚本），因此类型错误会挡住镜像构建——
# 这是有意的：一个类型都过不去的产物不该被发布。
RUN npm run build

# ---------------------------------------------------------------- 运行阶段
FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/frontend/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD ["wget", "-q", "-O", "-", "http://127.0.0.1/healthz"]

# 默认配置：前台运行（容器里 nginx 必须是 1 号进程，否则 docker stop 会等超时）。
CMD ["nginx", "-g", "daemon off;"]
