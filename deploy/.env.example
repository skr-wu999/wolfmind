# WolfMind 部署参数模板。
#
# 复制成 deploy/.env 后按需修改；**.env 不进仓库**（见仓库根的 .gitignore）。
# 不填任何一项也能启动：AI 走规则兜底，对局仍能正常打完。

# 对外访问端口（前端 Nginx）。
WOLFMIND_HTTP_PORT=8080

# Maven 镜像源（**构建期**）。留空用官方 Maven Central；
# 若所在网络访问 Central 被拒（403），填一个可达的镜像，例如：
#   WOLFMIND_MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public
WOLFMIND_MAVEN_MIRROR_URL=

# ------------------------------------------------------------------ 模型（可选）
# 三项都填齐才会真正调用模型；只填 API_KEY 不算配置（provider 是开关）。
# provider 取值：openai / openai-compatible / deepseek / ollama / none
WOLFMIND_LLM_PROVIDER=
WOLFMIND_LLM_BASE_URL=
WOLFMIND_LLM_API_KEY=
WOLFMIND_LLM_MODEL=
# 推理模式：留空=供应商默认 / enabled / disabled / speech-off / speech-low（见 docs/ai/agent-runtime.md §13）
WOLFMIND_LLM_THINKING=
# 原生工具调用；回退到旧 JSON 提案可设 JSON_PROPOSAL
WOLFMIND_LLM_INTERACTION_MODE=FUNCTION_CALLING
# 单次调用超时（毫秒）
WOLFMIND_LLM_TIMEOUT_MS=30000

# ------------------------------------------------------------------ 成本与并发
# 单局 token 上限（prompt + completion）。超过后该座位转规则兜底，对局仍会正常结束。
# 0 = 不限。默认不限是刻意的：一个没被验证过的默认上限会在真实对局里悄悄改变行为。
WOLFMIND_LLM_MAX_TOKENS_PER_GAME=0
# 实验室全局并发上限（api-spec.md §8 的 lab.maxConcurrentGames）。
# 注意：Spring 对环境变量做的是键名转换，所以两个键名分别对应
#   LAB_MAXCONCURRENTGAMES          （← lab.maxConcurrentGames）
#   WOLFMIND_LAB_MAX_CONCURRENT_GAMES（← wolfmind.lab.max-concurrent-games）
# 两者都接受，写哪个都行。
WOLFMIND_LAB_MAX_CONCURRENT_GAMES=8
# 投票阶段的并发派发线程数（agent-runtime.md §4.1）。
WOLFMIND_AGENT_MAX_CONCURRENT_TURNS=8

# 回合调度：EVENT_DRIVEN（默认）；POLLING 为重启后显式回退，两者复用持久化任务身份。
WOLFMIND_GAME_DRIVER_MODE=EVENT_DRIVEN
# 模型与超时执行器分别设有限队列，满时保留 READY 任务。
WOLFMIND_GAME_DRIVER_QUEUE_SIZE=64

# 房间断线宽限与补漏周期（毫秒）。刷新/短暂断线在宽限内不退出。
WOLFMIND_ROOM_DISCONNECT_GRACE_MS=120000
WOLFMIND_ROOM_RECONCILE_MS=30000

# AI 回合内部的工作流：默认 LANGGRAPH4J；改为 SEQUENTIAL 并重启可回退。
WOLFMIND_AGENT_WORKFLOW_ENGINE=LANGGRAPH4J
# CONFIG uses each seat's AgentConfig.mode; B enables two-stage speech for new agents.
WOLFMIND_AGENT_SPEECH_MODE=CONFIG
